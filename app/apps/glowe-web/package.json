{
  "name": "@kc/glowe-web",
  "private": true,
  "version": "0.0.0",
  "description": "GloWe static frontend (HTML script-tag entry points). Included so fallow treats the site as reachable.",
  "scripts": {
    "predev": "node ../../../scripts/stamp-glowe-version.mjs",
    "prestart": "node ../../../scripts/stamp-glowe-version.mjs",
    "dev": "npx --yes serve . --listen 4321 --no-port-switching -c ../../../tests/e2e/glowe-serve.json",
    "start": "npx --yes serve . --listen 4321 --no-port-switching -c ../../../tests/e2e/glowe-serve.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "vitest": "^4.1.8"
  }
}
