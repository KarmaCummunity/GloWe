{
  "name": "@kc/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/slider",
        "@sentry/react-native",
        "expo-device",
        "expo-file-system",
        "expo-font",
        "expo-localization",
        "expo-router"
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=70",
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:go:tunnel": "expo start --go --tunnel",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "node ../../../scripts/generate-web-manifest.mjs && expo start --web",
    "build:web": "node ../../../scripts/generate-web-manifest.mjs && expo export --platform web",
    "typecheck": "node ../../../scripts/generate-typed-routes.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.0",
    "@expo-google-fonts/rubik": "0.4.2",
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@kc/application": "workspace:*",
    "@kc/domain": "workspace:*",
    "@kc/infrastructure-supabase": "workspace:*",
    "@kc/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "^5.2.0",
    "@sentry/react-native": "^8.32.0",
    "@supabase/supabase-js": "^2.69.0",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "date-fns": "^4.1.0",
    "expo": "~54.0.38",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~7.0",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "i18next": "^23.16.0",
    "idb-keyval": "^6.2.1",
    "leaflet": "1.9.4",
    "posthog-react-native": "^4.81.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.26.20",
    "react-native-markdown-display": "^7.0.2",
    "react-native-purchases": "^9",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "whatwg-fetch": "^3.6.20",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@sentry/cli": "^3.4.3",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.1.17",
    "babel-preset-expo": "~54.0.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
