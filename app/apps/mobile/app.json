{
  "expo": {
    "name": "KC - קהילת קארמה",
    "slug": "karma-community",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F97316"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "org.karmacommunity.app",
      "associatedDomains": ["applinks:karma-community-kc.com"],
      "infoPlist": {
        "CFBundleDisplayName": "KC",
        "NSCameraUsageDescription": "נדרש לצלם תמונות לפוסטים",
        "NSPhotoLibraryUsageDescription": "נדרש לבחור תמונות לפוסטים"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F97316"
      },
      "package": "org.karmacommunity.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "karma-community-kc.com", "pathPrefix": "/auth/verify" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "themeColor": "#F97316",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "shortName": "KC"
    },
    "plugins": [
      "expo-dev-client",
      "expo-apple-authentication",
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "נדרש לבחור תמונות לפוסטים"
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A8754",
          "sounds": []
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "karma-community",
          "project": "kc-mobile"
        }
      ]
    ],
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "karmacommunity",
    "owner": "karmacommunity"
  }
}
