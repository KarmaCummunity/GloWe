# macOS
.DS_Store

# Supabase CLI
supabase/.temp/
supabase/.branches/

# Expo cache (transient; never tracked at any level)
.expo/

# IDE caches
.vscode/
.idea/

# Claude / agent worktree marker (the actual worktree dir is checked-in
# only as a metadata pointer; transient state inside it should not be
# tracked).
.claude/worktrees/*/.DS_Store
.claude/.DS_Store
.claude/scheduled_tasks.lock

# Agent PR body scratch file (generated per-PR by `gh pr create --body-file`).
.github/.pr-body.md

# Autonomous loop runtime artifacts (CLAUDE.md §13) — local-only.
.claude/AUTONOMOUS_LOOP_LOG.md
.claude/HALT_LOOP
.claude/LOOP_ENABLED

# Env files — never committed. Dev secrets live at ~/.kc-dev-secrets.env.
.env
.env.local
.env.*.local

# Aider AI coding assistant
.aider*

# Hebrew literal scan — generated report (timestamp churn); CI uses --check only.
scripts/hebrew-text-report.md

# Superpowers brainstorming sessions (visual companion mockups, transient)
.superpowers/

# Turborepo local cache — per-machine build artifacts, never committed.
.turbo/

# Git worktrees (local isolated checkouts — never commit contents).
.worktrees/

# Local Cursor editor settings (per-machine, not shared)
.cursor/settings.json

# Node deps. The pnpm workspace lives under app/, but CI (ci-frontend.yml,
# ci-glowe-perf.yml) installs Playwright at the repo root with
# `npm install --no-save`, which materialises a root node_modules/. Ignored so
# that never lands in a commit.
node_modules/
package-lock.json
